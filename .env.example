# Copy to .env for local runs. On Railway, set these as service Variables
# instead -- never commit real values.

# From whoever runs the relay
RELAY_URL=https://your-relay.up.railway.app
RELAY_CLIENT_TOKEN=

# Your own Polymarket account
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_WALLET=

# Safe by default: true = price orders and log them, but never place one.
# Set to exactly "false" to trade for real.
DRY_RUN=true

# Optional local safety cap per signal (USDC). The relay's own cap still
# applies; the smaller of the two wins.
MAX_STAKE_USDC=5
POLL_INTERVAL_SECONDS=5

# Leave unset for normal operation. "test-order" runs one tiny place-and-cancel
# account check (see test_order.py) instead of the trading loop, then exits.
# RUN_MODE=test-order
